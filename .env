# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="AIzaSyD-aKRNigGb-CF4SYtyl-6mFCMa1PJXncs"

# OLLAMA_API_KEY: Optional. The API Key or Authorization Token if Ollama is hosted behind a secure gateway or proxy.
OLLAMA_API_KEY="8fe3ec477eee46cfb2a9f1b99237d219.-bAPD5IqFlh1KdEnatjMp1hU"

# OLLAMA_BASE_URL: The base URL of your Ollama instances. Defaults to http://localhost:11434.
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# OLLAMA_MODEL: The model name to run (e.g. gemma2, llama3, mistral, qwen2.5). Defaults to llama3.
OLLAMA_MODEL="gemma4"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
